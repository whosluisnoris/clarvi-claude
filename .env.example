# Variables de entorno de CLARVI CLAUDE.
# Copia este archivo a .env.local y completa los valores reales.
# Nunca subas .env.local ni ningún archivo con valores reales al repositorio.

# URL del proyecto de Supabase (pública, se expone al cliente).
NEXT_PUBLIC_SUPABASE_URL=

# Llave anónima (anon/public) de Supabase (pública, se expone al cliente).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de rol de servicio de Supabase.
# SOLO servidor, jamás con prefijo NEXT_PUBLIC_. No exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Dominio para los correos internos derivados del username
# (ej. usuarios.interno.local).
DOMINIO_CORREO_SINTETICO=

# URL pública base de la aplicación (usada para construir enlaces, redirecciones, etc.).
NEXT_PUBLIC_APP_URL=

# Usuario del administrador inicial.
# Solo para el script de semilla.
ADMIN_INICIAL_USUARIO=

# Contraseña del administrador inicial.
# Solo para el script de semilla.
ADMIN_INICIAL_PASSWORD=

# Contraseña del grupo con la que el script de semilla da de alta a los
# participantes de ejemplo. Solo para scripts/semilla.ts; en producción la
# contraseña vigente se establece rotándola desde el panel.
PASSWORD_GRUPO_SEMILLA=
